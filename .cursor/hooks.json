{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/session-start.py"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/shell-guard.py",
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/content-edit-reminder.py",
        "matcher": "Write"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/content-edit-reminder.py",
        "matcher": "Write"
      }
    ]
  }
}
